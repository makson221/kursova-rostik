<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Палітра «Ватра»: темний еспресо-фон, теплі бурштинові акценти.
        Усі кольори інтерфейсу беруться лише звідси.
    -->

    <!-- Шрифти -->
    <FontFamily x:Key="UiFont">avares://RestaurantSystem/Assets/Fonts#Manrope</FontFamily>
    <FontFamily x:Key="DisplayFont">avares://RestaurantSystem/Assets/Fonts#IBM Plex Serif</FontFamily>
    <FontFamily x:Key="MonoFont">avares://RestaurantSystem/Assets/Fonts#JetBrains Mono</FontFamily>

    <!-- Поверхні -->
    <Color x:Key="Bg0Color">#110E0C</Color>
    <Color x:Key="Bg1Color">#16120F</Color>
    <Color x:Key="SurfaceColor">#1E1915</Color>
    <Color x:Key="Surface2Color">#27201B</Color>
    <Color x:Key="Surface3Color">#322922</Color>
    <Color x:Key="StrokeColor">#3B3129</Color>
    <Color x:Key="StrokeSoftColor">#2A231D</Color>

    <!-- Текст -->
    <Color x:Key="TextColor">#F6EEE6</Color>
    <Color x:Key="TextMutedColor">#A89A8D</Color>
    <Color x:Key="TextDimColor">#74675C</Color>
    <Color x:Key="OnAccentColor">#1A120C</Color>

    <!-- Акценти та статуси -->
    <Color x:Key="AccentColor">#F2A65A</Color>
    <Color x:Key="EmberColor">#E8553A</Color>
    <Color x:Key="GreenColor">#6FCF97</Color>
    <Color x:Key="BlueColor">#6FA8F2</Color>
    <Color x:Key="RedColor">#EF6B5E</Color>
    <Color x:Key="YellowColor">#F4D35E</Color>
    <Color x:Key="PurpleColor">#B794F6</Color>

    <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0Color}" />
    <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1Color}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeSoftBrush" Color="{StaticResource StrokeSoftColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="EmberBrush" Color="{StaticResource EmberColor}" />
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource YellowColor}" />
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}" />

    <!-- Напівпрозорі «підкладки» під іконки та бейджі -->
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2BF2A65A" />
    <SolidColorBrush x:Key="GreenSoftBrush" Color="#246FCF97" />
    <SolidColorBrush x:Key="BlueSoftBrush" Color="#246FA8F2" />
    <SolidColorBrush x:Key="RedSoftBrush" Color="#26EF6B5E" />
    <SolidColorBrush x:Key="YellowSoftBrush" Color="#24F4D35E" />
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#24B794F6" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#C80A0806" />

    <!-- Фірмові градієнти -->
    <LinearGradientBrush x:Key="FlameBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#FFC977" />
        <GradientStop Offset="0.55" Color="#F2873F" />
        <GradientStop Offset="1" Color="#E4483A" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FlameHoverBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#FFD592" />
        <GradientStop Offset="0.55" Color="#F79A55" />
        <GradientStop Offset="1" Color="#EC5A4A" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FlameVerticalBrush" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="#FFC977" />
        <GradientStop Offset="1" Color="#E4483A" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardGlowBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#2A211B" />
        <GradientStop Offset="1" Color="#1B1613" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RailBrush" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="#1A1511" />
        <GradientStop Offset="1" Color="#120F0D" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="EmberGlowBrush" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
        <GradientStop Offset="0" Color="#55F2873F" />
        <GradientStop Offset="1" Color="#00F2873F" />
    </RadialGradientBrush>

    <!-- Fluent: заокруглення стандартних контролів -->
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>

    <!-- Fluent: тексти полів введення -->
    <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2B231D" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#4D4036" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#66F2A65A" />

    <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#4D4036" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#231D18" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource StrokeColor}" />
</ResourceDictionary>
