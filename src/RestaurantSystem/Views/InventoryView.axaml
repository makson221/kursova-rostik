<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestaurantSystem.ViewModels"
             xmlns:c="using:RestaurantSystem.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="RestaurantSystem.Views.InventoryView"
             x:DataType="vm:InventoryViewModel"
             Classes="page">

    <Grid ColumnDefinitions="*,18,370">
        <Grid RowDefinitions="Auto,Auto,*">
            <!-- Підсумки -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Classes="card" Padding="18,14" Margin="0,0,12,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="iconBubble"><mi:MaterialIcon Kind="PackageVariantClosed" Foreground="{StaticResource AccentBrush}" Width="20" Height="20" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="ExtraBold" />
                            <TextBlock Text="позицій на складі" Classes="muted small" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Classes="card" Padding="18,14" Margin="0,0,12,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="iconBubble" Background="{StaticResource YellowSoftBrush}"><mi:MaterialIcon Kind="AlertOutline" Foreground="{StaticResource YellowBrush}" Width="20" Height="20" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LowCount}" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource YellowBrush}" />
                            <TextBlock Text="нижче мінімуму" Classes="muted small" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Classes="card" Padding="18,14" Margin="0,0,12,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="iconBubble" Background="{StaticResource RedSoftBrush}"><mi:MaterialIcon Kind="AlertOctagonOutline" Foreground="{StaticResource RedBrush}" Width="20" Height="20" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CriticalCount}" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource RedBrush}" />
                            <TextBlock Text="критичний залишок" Classes="muted small" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Classes="card" Padding="18,14">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="iconBubble" Background="{StaticResource GreenSoftBrush}"><mi:MaterialIcon Kind="CashMultiple" Foreground="{StaticResource GreenBrush}" Width="20" Height="20" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StockValueText}" FontSize="22" FontWeight="ExtraBold" />
                            <TextBlock Text="вартість запасів" Classes="muted small" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Фільтри -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,14">
                <ItemsControl ItemsSource="{Binding Filters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StockFilter">
                            <Button Classes="chip" Classes.active="{Binding IsSelected}" Content="{Binding Title}"
                                    Command="{Binding SelectCommand}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Panel Grid.Column="1" Margin="14,0,0,0" MaxWidth="360" HorizontalAlignment="Right">
                    <TextBox Classes="search" Text="{Binding Search}" Watermark="Пошук продукту…" Width="320" />
                    <mi:MaterialIcon Kind="Magnify" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Left"
                                     Margin="14,0,0,0" IsHitTestVisible="False" />
                </Panel>
            </Grid>

            <!-- Таблиця -->
            <Border Grid.Row="2" Classes="card" Padding="8">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="2*,1.2*,1.4*,1*,1*,1*" Margin="16,8,16,10">
                        <TextBlock Text="ПРОДУКТ" Classes="caption" />
                        <TextBlock Grid.Column="1" Text="ЗАЛИШОК" Classes="caption" />
                        <TextBlock Grid.Column="2" Text="РІВЕНЬ ЗАПАСУ" Classes="caption" />
                        <TextBlock Grid.Column="3" Text="СТАН" Classes="caption" />
                        <TextBlock Grid.Column="4" Text="ЦІНА" Classes="caption" />
                        <TextBlock Grid.Column="5" Text="ВАРТІСТЬ" Classes="caption" HorizontalAlignment="Right" />
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StockRow">
                                    <Button Classes="row" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}"
                                            Padding="16,11" Margin="0,0,0,2">
                                        <Grid ColumnDefinitions="2*,1.2*,1.4*,1*,1*,1*">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding QuantityText}" FontWeight="Bold" Classes="mono" FontSize="13" />
                                                <TextBlock Text="{Binding MinText}" Classes="dim" FontSize="11" />
                                            </StackPanel>
                                            <c:LevelMeter Grid.Column="2" Value="{Binding Level}" Fill="{Binding Tone}"
                                                          Margin="0,0,24,0" VerticalAlignment="Center" />
                                            <Border Grid.Column="3" Classes="badge" Background="{Binding ToneSoft}">
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding Tone}" />
                                            </Border>
                                            <TextBlock Grid.Column="4" Text="{Binding CostText}" Classes="muted small" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding ValueText}" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Редактор ================= -->
        <Border Grid.Column="2" Classes="card" Padding="22,20">
            <ScrollViewer>
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding EditorTitle}" Classes="h2" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Картка продукту" Classes="dim small" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="soft" Padding="12,8" Command="{Binding NewCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                                <TextBlock Text="Новий" Foreground="{Binding $parent[Button].Foreground}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Швидке поповнення -->
                    <Border CornerRadius="16" Padding="16" Background="{StaticResource GreenSoftBrush}" IsVisible="{Binding IsExisting}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="TruckDeliveryOutline" Foreground="{StaticResource GreenBrush}" />
                                <TextBlock Text="Прихід товару" FontWeight="Bold" Foreground="{StaticResource GreenBrush}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,8,Auto">
                                <NumericUpDown Value="{Binding RestockAmount}" Minimum="0" Increment="1" FormatString="0.###"
                                               ShowButtonSpinner="False" Watermark="Кількість" />
                                <Button Grid.Column="2" Classes="success" Content="Поповнити" Command="{Binding RestockCommand}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="chip" Content="+1" Command="{Binding QuickAmountCommand}" CommandParameter="1" />
                                <Button Classes="chip" Content="+5" Command="{Binding QuickAmountCommand}" CommandParameter="5" />
                                <Button Classes="chip" Content="+10" Command="{Binding QuickAmountCommand}" CommandParameter="10" />
                                <Button Classes="chip" Content="+25" Command="{Binding QuickAmountCommand}" CommandParameter="25" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <TextBlock Text="Назва" Classes="label" />
                        <TextBox Text="{Binding EditName}" Watermark="Напр.: Картопля" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,10,*">
                        <StackPanel>
                            <TextBlock Text="Одиниця" Classes="label" />
                            <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding EditUnit}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ціна за од., ₴" Classes="label" />
                            <NumericUpDown Value="{Binding EditCost}" Minimum="0" Increment="1" FormatString="0.##"
                                           ShowButtonSpinner="False" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,10,*">
                        <StackPanel>
                            <TextBlock Text="Залишок" Classes="label" />
                            <NumericUpDown Value="{Binding EditQuantity}" Minimum="0" Increment="1" FormatString="0.###"
                                           ShowButtonSpinner="False" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Мінімум" Classes="label" />
                            <NumericUpDown Value="{Binding EditMin}" Minimum="0" Increment="1" FormatString="0.###"
                                           ShowButtonSpinner="False" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Коли залишок опускається нижче мінімуму, продукт з'являється в сповіщеннях на головній панелі."
                               Classes="dim small" TextWrapping="Wrap" LineHeight="18" />

                    <Grid ColumnDefinitions="*,10,Auto" Margin="0,6,0,0">
                        <Button Classes="primary" Height="46" HorizontalAlignment="Stretch" Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="ContentSaveOutline" Foreground="{StaticResource OnAccentBrush}" />
                                <TextBlock Text="Зберегти" Foreground="{StaticResource OnAccentBrush}" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="danger" Height="46" Width="46" Padding="0" Command="{Binding DeleteCommand}"
                                IsVisible="{Binding IsExisting}" ToolTip.Tip="Видалити">
                            <mi:MaterialIcon Kind="TrashCanOutline" Width="20" Height="20" />
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
