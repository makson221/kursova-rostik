<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestaurantSystem.ViewModels"
             xmlns:c="using:RestaurantSystem.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="RestaurantSystem.Views.KitchenView"
             x:DataType="vm:KitchenViewModel"
             Classes="page">

    <UserControl.Styles>
        <Style Selector="Border.column">
            <Setter Property="Background" Value="#17130F" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Border.ticket">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.ticket.overdue">
            <Setter Property="BorderBrush" Value="#80EF6B5E" />
        </Style>
        <Style Selector="Border.tableTag">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Панель стану -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="badge" Background="{StaticResource RedSoftBrush}" Padding="12,6" IsVisible="{Binding HasOverdue}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <mi:MaterialIcon Kind="TimerAlertOutline" Foreground="{StaticResource RedBrush}" Width="16" Height="16" />
                        <TextBlock Foreground="{StaticResource RedBrush}" FontSize="12.5">
                            <Run Text="Затримка:" />
                            <Run Text="{Binding OverdueCount}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Classes="badge" Background="{StaticResource GreenSoftBrush}" Padding="12,6" IsVisible="{Binding !HasOverdue}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <mi:MaterialIcon Kind="TimerCheckOutline" Foreground="{StaticResource GreenBrush}" Width="16" Height="16" />
                        <TextBlock Text="Усе за графіком" Foreground="{StaticResource GreenBrush}" FontSize="12.5" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding UpdatedText}" Classes="dim small" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="Refresh" />
                    <TextBlock Text="Оновити" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,16,*,16,*">

            <!-- ============ Нові ============ -->
            <Border Classes="column">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,4,6,14">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource BlueBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Нові" Classes="h2" Margin="10,0,0,0" />
                        <Border Grid.Column="2" Classes="badge" Background="{StaticResource BlueSoftBrush}">
                            <TextBlock Text="{Binding NewCount}" Foreground="{StaticResource BlueBrush}" />
                        </Border>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding NewTickets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:KitchenTicket">
                                    <Border Classes="ticket" Classes.overdue="{Binding IsOverdue}">
                                        <Grid ColumnDefinitions="4,*">
                                            <Border Background="{StaticResource BlueBrush}" />
                                            <StackPanel Grid.Column="1" Margin="14,12" Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding DishName}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding WaiterText}" Classes="dim small" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="4" Margin="10,0,0,0">
                                                        <Border Classes="tableTag" Background="{StaticResource BlueSoftBrush}">
                                                            <TextBlock Text="{Binding TableText}" FontWeight="ExtraBold"
                                                                       Foreground="{StaticResource BlueBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding QuantityText}" Classes="mono" FontWeight="Bold" FontSize="18"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                                <Border Background="{StaticResource YellowSoftBrush}" CornerRadius="9" Padding="10,6"
                                                        IsVisible="{Binding HasNote}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <mi:MaterialIcon Kind="AlertCircleOutline" Foreground="{StaticResource YellowBrush}"
                                                                         Width="15" Height="15" />
                                                        <TextBlock Text="{Binding Note}" Foreground="{StaticResource YellowBrush}"
                                                                   FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <mi:MaterialIcon Kind="ClockOutline" Foreground="{Binding TimeTone}" Width="15" Height="15" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ElapsedText}" Foreground="{Binding TimeTone}"
                                                               FontWeight="SemiBold" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                    <Button Grid.Column="2" Classes="soft" Padding="12,7" Command="{Binding AdvanceCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <mi:MaterialIcon Kind="{Binding ActionIcon}" Width="16" Height="16" />
                                                            <TextBlock Text="{Binding ActionText}" Foreground="{Binding $parent[Button].Foreground}" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ============ Готуються ============ -->
            <Border Grid.Column="2" Classes="column">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,4,6,14">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Готуються" Classes="h2" Margin="10,0,0,0" />
                        <Border Grid.Column="2" Classes="badge" Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Text="{Binding CookingCount}" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding CookingTickets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:KitchenTicket">
                                    <Border Classes="ticket" Classes.overdue="{Binding IsOverdue}">
                                        <Grid ColumnDefinitions="4,*">
                                            <Border Background="{StaticResource FlameVerticalBrush}" />
                                            <StackPanel Grid.Column="1" Margin="14,12" Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding DishName}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding CookTimeText}" Classes="dim small" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="4" Margin="10,0,0,0">
                                                        <Border Classes="tableTag" Background="{StaticResource AccentSoftBrush}">
                                                            <TextBlock Text="{Binding TableText}" FontWeight="ExtraBold"
                                                                       Foreground="{StaticResource AccentBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding QuantityText}" Classes="mono" FontWeight="Bold" FontSize="18"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                                <Border Background="{StaticResource YellowSoftBrush}" CornerRadius="9" Padding="10,6"
                                                        IsVisible="{Binding HasNote}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <mi:MaterialIcon Kind="AlertCircleOutline" Foreground="{StaticResource YellowBrush}"
                                                                         Width="15" Height="15" />
                                                        <TextBlock Text="{Binding Note}" Foreground="{StaticResource YellowBrush}"
                                                                   FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <c:LevelMeter Value="{Binding Progress}" Fill="{StaticResource FlameBrush}" Height="5" />
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <mi:MaterialIcon Kind="Fire" Foreground="{Binding TimeTone}" Width="15" Height="15" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ElapsedText}" Foreground="{Binding TimeTone}"
                                                               FontWeight="SemiBold" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                    <Button Grid.Column="2" Classes="success" Padding="12,7" Command="{Binding AdvanceCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <mi:MaterialIcon Kind="{Binding ActionIcon}" Width="16" Height="16" />
                                                            <TextBlock Text="{Binding ActionText}" Foreground="{Binding $parent[Button].Foreground}" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ============ Готові ============ -->
            <Border Grid.Column="4" Classes="column">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,4,6,14">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Готові до видачі" Classes="h2" Margin="10,0,0,0" />
                        <Border Grid.Column="2" Classes="badge" Background="{StaticResource GreenSoftBrush}">
                            <TextBlock Text="{Binding ReadyCount}" Foreground="{StaticResource GreenBrush}" />
                        </Border>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding ReadyTickets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:KitchenTicket">
                                    <Border Classes="ticket" Classes.overdue="{Binding IsOverdue}">
                                        <Grid ColumnDefinitions="4,*">
                                            <Border Background="{StaticResource GreenBrush}" />
                                            <Grid Grid.Column="1" Margin="14,12" ColumnDefinitions="Auto,*,Auto">
                                                <Border Classes="tableTag" Background="{StaticResource GreenSoftBrush}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TableText}" FontWeight="ExtraBold" FontSize="15"
                                                               Foreground="{StaticResource GreenBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock FontWeight="Bold" FontSize="14" TextWrapping="Wrap">
                                                        <Run Text="{Binding DishName}" />
                                                        <Run Text="{Binding QuantityText}" Foreground="{StaticResource TextMutedBrush}" />
                                                    </TextBlock>
                                                    <TextBlock Classes="small" Foreground="{Binding TimeTone}">
                                                        <Run Text="чекає" />
                                                        <Run Text="{Binding ElapsedText}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="ghost" Padding="10,7" Command="{Binding AdvanceCommand}"
                                                        ToolTip.Tip="Позначити як видане гостю">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <mi:MaterialIcon Kind="{Binding ActionIcon}" Width="16" Height="16" />
                                                        <TextBlock Text="{Binding ActionText}" Foreground="{Binding $parent[Button].Foreground}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
