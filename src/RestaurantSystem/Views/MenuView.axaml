<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestaurantSystem.ViewModels"
             xmlns:m="using:RestaurantSystem.Models"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="RestaurantSystem.Views.MenuView"
             x:DataType="vm:MenuViewModel"
             Classes="page">

    <Grid ColumnDefinitions="236,18,*,18,400">

        <!-- ================= Категорії ================= -->
        <Border Classes="card" Padding="12,16">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Text="КАТЕГОРІЇ" Classes="caption" Margin="10,0,0,10" />
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding CategoryItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MenuCategoryItem">
                                <Button Classes="row" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}"
                                        Margin="0,0,0,3">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <mi:MaterialIcon Kind="{Binding Icon}" Foreground="{Binding Tone}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="dim small" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
                    <Border Classes="divider" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewCategoryName}" Watermark="Нова категорія" />
                    <Grid ColumnDefinitions="*,8,Auto">
                        <Button Classes="soft" HorizontalAlignment="Stretch" Command="{Binding AddCategoryCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="Plus" />
                                <TextBlock Text="Додати" Foreground="{Binding $parent[Button].Foreground}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="danger icon" Command="{Binding DeleteCategoryCommand}"
                                ToolTip.Tip="Видалити вибрану категорію">
                            <mi:MaterialIcon Kind="TrashCanOutline" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Страви ================= -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <Panel>
                    <TextBox Classes="search" Text="{Binding Search}" Watermark="Пошук у меню…" />
                    <mi:MaterialIcon Kind="Magnify" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Left"
                                     Margin="14,0,0,0" IsHitTestVisible="False" />
                </Panel>
                <Button Grid.Column="1" Classes="primary" Margin="12,0,0,0" Command="{Binding NewDishCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Plus" Foreground="{StaticResource OnAccentBrush}" />
                        <TextBlock Text="Нова страва" Foreground="{StaticResource OnAccentBrush}" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Grid.Row="1" Classes="card" Padding="8">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MenuDishRow">
                                <Button Classes="row" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}"
                                        Padding="12,11" Margin="0,0,0,2">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Border Width="6" Height="34" CornerRadius="3" Background="{Binding Tone}" />
                                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Name}" />
                                                <Run Text="{Binding Portion}" Foreground="{StaticResource TextDimBrush}" FontWeight="Normal"
                                                     FontSize="12" />
                                            </TextBlock>
                                            <TextBlock Classes="dim small" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding CategoryName}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding CostText}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding PriceText}" FontWeight="ExtraBold" FontSize="15"
                                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <Panel Grid.Column="3" VerticalAlignment="Center">
                                            <Button Classes="success" Padding="10,5" FontSize="11.5" Command="{Binding ToggleCommand}"
                                                    IsVisible="{Binding IsAvailable}" ToolTip.Tip="Натисніть, щоб поставити на стоп">
                                                <TextBlock Text="У продажу" Foreground="{Binding $parent[Button].Foreground}" FontSize="11.5" />
                                            </Button>
                                            <Button Classes="danger" Padding="10,5" Command="{Binding ToggleCommand}"
                                                    IsVisible="{Binding IsUnavailable}" ToolTip.Tip="Натисніть, щоб повернути в продаж">
                                                <TextBlock Text="Стоп-лист" Foreground="{Binding $parent[Button].Foreground}" FontSize="11.5" />
                                            </Button>
                                        </Panel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= Редактор ================= -->
        <Border Grid.Column="4" Classes="card" Padding="0">
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer>
                    <StackPanel Spacing="14" Margin="22,20,22,10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="iconBubble">
                                <mi:MaterialIcon Kind="SilverwareForkKnife" Foreground="{StaticResource AccentBrush}" Width="20" Height="20" />
                            </Border>
                            <TextBlock Text="{Binding EditorTitle}" Classes="h2" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Назва" Classes="label" />
                            <TextBox Text="{Binding EditName}" Watermark="Напр.: Борщ український" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Категорія" Classes="label" />
                            <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding EditCategory}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:Category">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,10,*,10,*">
                            <StackPanel>
                                <TextBlock Text="Ціна, ₴" Classes="label" />
                                <NumericUpDown Value="{Binding EditPrice}" Minimum="0" Increment="5" FormatString="0.##"
                                               ShowButtonSpinner="False" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Вихід" Classes="label" />
                                <TextBox Text="{Binding EditPortion}" Watermark="250 г" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Час, хв" Classes="label" />
                                <NumericUpDown Value="{Binding EditCookTime}" Minimum="1" Maximum="180" Increment="1"
                                               FormatString="0" ShowButtonSpinner="False" />
                            </StackPanel>
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="Опис для меню" Classes="label" />
                            <TextBox Classes="multiline" Text="{Binding EditDescription}" Watermark="Склад, подача, особливості" />
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding EditAvailable}" OnContent="Доступна для замовлення"
                                      OffContent="У стоп-листі" />

                        <Border Classes="divider" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Технологічна карта" Classes="h3" />
                                <TextBlock Text="Інгредієнти списуються зі складу автоматично" Classes="dim small" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="soft icon" Command="{Binding AddIngredientCommand}"
                                    ToolTip.Tip="Додати інгредієнт">
                                <mi:MaterialIcon Kind="Plus" />
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Recipe}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecipeLine">
                                    <Grid ColumnDefinitions="*,8,96,6,28,Auto">
                                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Ingredient}"
                                                  PlaceholderText="Інгредієнт" MinHeight="38">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="m:Ingredient">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <NumericUpDown Grid.Column="2" Value="{Binding Amount}" Minimum="0" Increment="0.01"
                                                       FormatString="0.###" ShowButtonSpinner="False" MinHeight="38" Watermark="0" />
                                        <TextBlock Grid.Column="4" Text="{Binding UnitText}" Classes="muted small" VerticalAlignment="Center" />
                                        <Button Grid.Column="5" Classes="ghost icon small" Command="{Binding RemoveCommand}">
                                            <mi:MaterialIcon Kind="Close" Width="16" Height="16" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Classes="panel" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Calculator" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding RecipeCostText}" Classes="muted small" VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1" ColumnDefinitions="*,10,Auto" Margin="22,10,22,20">
                    <Button Classes="primary" Height="46" HorizontalAlignment="Stretch" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="ContentSaveOutline" Foreground="{StaticResource OnAccentBrush}" />
                            <TextBlock Text="Зберегти" Foreground="{StaticResource OnAccentBrush}" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="danger" Height="46" Width="46" Padding="0" Command="{Binding DeleteCommand}"
                            IsVisible="{Binding IsExisting}" ToolTip.Tip="Видалити страву">
                        <mi:MaterialIcon Kind="TrashCanOutline" Width="20" Height="20" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
