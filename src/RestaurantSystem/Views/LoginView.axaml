<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestaurantSystem.ViewModels"
             xmlns:inf="using:RestaurantSystem.Infrastructure"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="RestaurantSystem.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Grid ColumnDefinitions="1.1*,*">

        <!-- ================= Ліва «вогняна» панель ================= -->
        <Border inf:WindowDrag.IsDragArea="True" ClipToBounds="True" Background="#0D0B09">
            <Panel>
                <!-- Розмиті жарини на фоні -->
                <Ellipse Width="520" Height="520" Fill="{StaticResource FlameBrush}" Opacity="0.42"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-180,0,0,-220"
                         Effect="blur(120)" />
                <Ellipse Width="300" Height="300" Fill="#E4483A" Opacity="0.2"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-60,-40,0"
                         Effect="blur(110)" />

                <!-- Концентричні кола як декоративний орнамент -->
                <Canvas HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="1" Height="1" Margin="0,0,30,90">
                    <Ellipse Canvas.Left="-210" Canvas.Top="-210" Width="420" Height="420" Stroke="#1EF2A65A" StrokeThickness="1" />
                    <Ellipse Canvas.Left="-150" Canvas.Top="-150" Width="300" Height="300" Stroke="#28F2A65A" StrokeThickness="1" />
                    <Ellipse Canvas.Left="-90" Canvas.Top="-90" Width="180" Height="180" Stroke="#33F2A65A" StrokeThickness="1"
                             StrokeDashArray="2,4" />
                </Canvas>

                <DockPanel Margin="64,56,64,48">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="14">
                        <Image Source="/Assets/logo.png" Width="52" Height="52" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ВАТРА" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                                       FontSize="24" LetterSpacing="6" />
                            <TextBlock Text="RESTAURANT OS" Classes="caption" LetterSpacing="3.2" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" Classes="dim small"
                               Text="Курсовий проєкт · Автоматизована система ресторану · C# / .NET 8 / Avalonia" />

                    <StackPanel VerticalAlignment="Center" Spacing="26" MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock FontFamily="{StaticResource DisplayFont}" FontStyle="Italic" FontWeight="Medium"
                                   FontSize="50" LineHeight="58" TextWrapping="Wrap">
                            <Run Text="Тепло," />
                            <LineBreak />
                            <Run Text="що збирає" />
                            <Run Text="разом." Foreground="{StaticResource AccentBrush}" />
                        </TextBlock>
                        <TextBlock Classes="muted" FontSize="15" LineHeight="24" TextWrapping="Wrap"
                                   Text="Усе життя ресторану в одному вікні: від першого замовлення за столом до вечірнього звіту." />

                        <StackPanel Spacing="12" Margin="0,8,0,0">
                            <StackPanel.Styles>
                                <Style Selector="Border.feature">
                                    <Setter Property="Width" Value="34" />
                                    <Setter Property="Height" Value="34" />
                                    <Setter Property="CornerRadius" Value="10" />
                                    <Setter Property="Background" Value="#1FF2A65A" />
                                </Style>
                                <Style Selector="Border.feature > mi|MaterialIcon">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </Style>
                            </StackPanel.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Border Classes="feature"><mi:MaterialIcon Kind="TableFurniture" /></Border>
                                <TextBlock VerticalAlignment="Center" Text="Інтерактивний план зали та POS для офіціантів" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Border Classes="feature"><mi:MaterialIcon Kind="ChefHat" /></Border>
                                <TextBlock VerticalAlignment="Center" Text="Кухонний монітор з таймерами приготування" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Border Classes="feature"><mi:MaterialIcon Kind="PackageVariantClosed" /></Border>
                                <TextBlock VerticalAlignment="Center" Text="Склад і техкарти з автоматичним списанням" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Border Classes="feature"><mi:MaterialIcon Kind="ChartBoxOutline" /></Border>
                                <TextBlock VerticalAlignment="Center" Text="Аналітика продажів та експорт звітів" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Panel>
        </Border>

        <!-- ================= Форма входу ================= -->
        <Border Grid.Column="1" inf:WindowDrag.IsDragArea="True" Background="{StaticResource Bg1Brush}"
                BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1,0,0,0">
            <StackPanel Width="380" VerticalAlignment="Center" Spacing="0">
                <TextBlock Text="{Binding Greeting}" Classes="accent" FontWeight="Bold" FontSize="13" />
                <TextBlock Text="Вхід до системи" Classes="display" Margin="0,6,0,4" />
                <TextBlock Text="{Binding TodayText}" Classes="muted" Margin="0,0,0,30" />

                <TextBlock Text="Логін" Classes="label" />
                <Panel Margin="0,0,0,16">
                    <TextBox Name="LoginBox" Classes="search" Text="{Binding Login}" Watermark="Введіть логін" />
                    <mi:MaterialIcon Kind="AccountOutline" Foreground="{StaticResource TextDimBrush}"
                                     HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False" />
                </Panel>

                <TextBlock Text="Пароль" Classes="label" />
                <Panel>
                    <TextBox Classes="search" Text="{Binding Password}" PasswordChar="●" Watermark="Введіть пароль" />
                    <mi:MaterialIcon Kind="LockOutline" Foreground="{StaticResource TextDimBrush}"
                                     HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False" />
                </Panel>

                <Border Background="{StaticResource RedSoftBrush}" CornerRadius="10" Padding="12,9" Margin="0,14,0,0"
                        IsVisible="{Binding HasError}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="AlertCircleOutline" Foreground="{StaticResource RedBrush}" />
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource RedBrush}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Button Classes="primary" Command="{Binding SignInCommand}" IsDefault="True"
                        HorizontalAlignment="Stretch" Height="50" Margin="0,22,0,0" FontSize="15">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Увійти" Foreground="{StaticResource OnAccentBrush}" FontWeight="Bold" />
                        <mi:MaterialIcon Kind="ArrowRight" Foreground="{StaticResource OnAccentBrush}" />
                    </StackPanel>
                </Button>

                <Grid ColumnDefinitions="*,Auto,*" Margin="0,34,0,16">
                    <Border Classes="divider" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="ДЕМО-ДОСТУП" Classes="caption" Margin="14,0" />
                    <Border Grid.Column="2" Classes="divider" VerticalAlignment="Center" />
                </Grid>

                <ItemsControl ItemsSource="{Binding DemoAccounts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DemoAccount">
                            <Button Classes="tile" Command="{Binding FillCommand}" Margin="4" Height="92" HorizontalAlignment="Stretch"
                                    ToolTip.Tip="Підставити облікові дані">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                    <mi:MaterialIcon Kind="{Binding Icon}" Width="22" Height="22"
                                                     Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding Role}" FontWeight="Bold" FontSize="12.5"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Hint}" Classes="dim mono" FontSize="10.5"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
