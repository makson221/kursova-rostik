<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RestaurantSystem.ViewModels"
        xmlns:inf="using:RestaurantSystem.Infrastructure"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="RestaurantSystem.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Ватра · Restaurant OS"
        Icon="/Assets/vatra.ico"
        Width="1440" Height="900" MinWidth="1200" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{StaticResource Bg0Brush}">

    <Window.Styles>
        <!-- Спливаючі повідомлення -->
        <Style Selector="Border.toast">
            <Setter Property="Background" Value="#2A221C" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="BoxShadow" Value="0 12 32 0 #66000000" />
            <Style.Animations>
                <Animation Duration="0:0:0.3" Easing="BackEaseOut" FillMode="Backward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="60" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.toast.success Border.toastIcon">
            <Setter Property="Background" Value="{StaticResource GreenSoftBrush}" />
        </Style>
        <Style Selector="Border.toast.success mi|MaterialIcon.toastIcon">
            <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
        </Style>
        <Style Selector="Border.toast.info Border.toastIcon">
            <Setter Property="Background" Value="{StaticResource BlueSoftBrush}" />
        </Style>
        <Style Selector="Border.toast.info mi|MaterialIcon.toastIcon">
            <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
        </Style>
        <Style Selector="Border.toast.warning Border.toastIcon">
            <Setter Property="Background" Value="{StaticResource YellowSoftBrush}" />
        </Style>
        <Style Selector="Border.toast.warning mi|MaterialIcon.toastIcon">
            <Setter Property="Foreground" Value="{StaticResource YellowBrush}" />
        </Style>
        <Style Selector="Border.toast.error Border.toastIcon">
            <Setter Property="Background" Value="{StaticResource RedSoftBrush}" />
        </Style>
        <Style Selector="Border.toast.error mi|MaterialIcon.toastIcon">
            <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
        </Style>

        <!-- Вікно діалогу -->
        <Style Selector="ContentControl.dialogHost > ContentPresenter">
            <Style.Animations>
                <Animation Duration="0:0:0.28" Easing="BackEaseOut" FillMode="Backward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.94" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.94" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Panel>
        <!-- Вхід або робоча оболонка -->
        <TransitioningContentControl Content="{Binding Root}">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.3" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>

        <!-- Власні кнопки керування вікном -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" ZIndex="10">
            <Button Classes="window" Click="OnMinimize" ToolTip.Tip="Згорнути">
                <mi:MaterialIcon Kind="WindowMinimize" Width="15" Height="15" />
            </Button>
            <Button Classes="window" Click="OnMaximize" ToolTip.Tip="Розгорнути">
                <mi:MaterialIcon Kind="CheckboxBlankOutline" Width="13" Height="13" />
            </Button>
            <Button Classes="window close" Click="OnClose" ToolTip.Tip="Закрити">
                <mi:MaterialIcon Kind="WindowClose" Width="16" Height="16" />
            </Button>
        </StackPanel>

        <!-- Модальні діалоги всередині вікна -->
        <Panel ZIndex="20" IsVisible="{Binding Dialogs.Current, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border Background="{StaticResource OverlayBrush}" />
            <ContentControl Classes="dialogHost"
                            Content="{Binding Dialogs.Current}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>

        <!-- Спливаючі повідомлення -->
        <ItemsControl ZIndex="30" ItemsSource="{Binding Toasts.Items}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,26,26" Width="380">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="inf:ToastMessage">
                    <Border Classes="toast"
                            Classes.success="{Binding IsSuccess}"
                            Classes.info="{Binding IsInfo}"
                            Classes.warning="{Binding IsWarning}"
                            Classes.error="{Binding IsError}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="toastIcon" Width="36" Height="36" CornerRadius="11" VerticalAlignment="Top">
                                <mi:MaterialIcon Classes="toastIcon" Kind="{Binding Icon}" Width="20" Height="20" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13.5" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                                           Classes="muted small" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Panel>
</Window>
