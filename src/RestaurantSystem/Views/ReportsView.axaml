<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestaurantSystem.ViewModels"
             xmlns:c="using:RestaurantSystem.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="RestaurantSystem.Views.ReportsView"
             x:DataType="vm:ReportsViewModel"
             Classes="page">

    <ScrollViewer>
        <StackPanel Spacing="18" Margin="0,0,6,0">
            <Grid ColumnDefinitions="*,Auto">
                <ItemsControl ItemsSource="{Binding Periods}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PeriodChip">
                            <Button Classes="chip" Classes.active="{Binding IsSelected}" Content="{Binding Title}"
                                    Command="{Binding SelectCommand}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Column="1" Classes="soft" Command="{Binding ExportCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="FileExcelOutline" />
                        <TextBlock Text="Експорт у CSV" Foreground="{Binding $parent[Button].Foreground}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- KPI -->
            <ItemsControl ItemsSource="{Binding Kpis}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KpiCard">
                        <Border Classes="card glow" Margin="0,0,12,0" Padding="18,16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Classes="iconBubble" Width="34" Height="34" CornerRadius="10" Background="{Binding ToneSoft}">
                                        <mi:MaterialIcon Kind="{Binding Icon}" Foreground="{Binding Tone}" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" Classes="muted" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="ExtraBold" />
                                <TextBlock Text="{Binding Caption}" Foreground="{Binding CaptionTone}" FontSize="11.5"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="card" IsVisible="{Binding IsEmpty}" Padding="30">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <mi:MaterialIcon Kind="ChartBoxOutline" Width="42" Height="42" Foreground="{StaticResource TextDimBrush}" />
                    <TextBlock Text="За обраний період продажів немає" Classes="h3" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Динаміка + категорії -->
            <Grid ColumnDefinitions="2*,14,*" IsVisible="{Binding HasData}">
                <Border Classes="card">
                    <Grid RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Динаміка виручки" Classes="h2" />
                            <TextBlock Grid.Column="1" Text="{Binding RevenueText}" Classes="accent" FontSize="20"
                                       FontWeight="ExtraBold" />
                        </Grid>
                        <c:BarChart Grid.Row="1" Points="{Binding DailyChart}" HighlightLast="False" Height="280" Margin="0,10,0,0" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Classes="card">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Категорії меню" Classes="h2" />
                        <c:DonutChart Segments="{Binding CategorySegments}" CenterTitle="усього" CenterValue="{Binding RevenueText}"
                                      Thickness="20" Width="180" Height="180" />
                        <ItemsControl ItemsSource="{Binding CategoryLegend}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LegendRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto,46">
                                        <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Tone}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0" FontSize="12.5" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="{Binding Share}" Classes="dim" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Години + оплати -->
            <Grid ColumnDefinitions="2*,14,*" IsVisible="{Binding HasData}">
                <Border Classes="card">
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel>
                            <TextBlock Text="Завантаженість за годинами" Classes="h2" />
                            <TextBlock Text="Кількість відкритих рахунків у кожну годину" Classes="dim small" Margin="0,3,0,0" />
                        </StackPanel>
                        <c:BarChart Grid.Row="1" Points="{Binding HourlyChart}" HighlightLast="False" Height="200" Margin="0,6,0,0" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Classes="card">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Способи оплати" Classes="h2" />
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <mi:MaterialIcon Kind="CreditCardChipOutline" Foreground="{StaticResource BlueBrush}" />
                                <TextBlock Grid.Column="1" Text="Картка" Margin="10,0" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" FontWeight="Bold">
                                    <Run Text="{Binding CardText}" />
                                    <Run Text="{Binding CardShareText}" Foreground="{StaticResource TextDimBrush}" FontWeight="Normal" />
                                </TextBlock>
                            </Grid>
                            <c:LevelMeter Value="{Binding CardShare}" Fill="{StaticResource BlueBrush}" Height="8" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <mi:MaterialIcon Kind="CashMultiple" Foreground="{StaticResource GreenBrush}" />
                                <TextBlock Grid.Column="1" Text="Готівка" Margin="10,0" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" FontWeight="Bold">
                                    <Run Text="{Binding CashText}" />
                                    <Run Text="{Binding CashShareText}" Foreground="{StaticResource TextDimBrush}" FontWeight="Normal" />
                                </TextBlock>
                            </Grid>
                            <c:LevelMeter Value="{Binding CashShare}" Fill="{StaticResource GreenBrush}" Height="8" />
                        </StackPanel>
                        <Border Classes="panel">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <mi:MaterialIcon Kind="TagOutline" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Grid.Column="1" Text="Надано знижок" Classes="muted" Margin="10,0" />
                                <TextBlock Grid.Column="2" Text="{Binding DiscountsText}" FontWeight="Bold" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Таблиці -->
            <Grid ColumnDefinitions="3*,14,2*" IsVisible="{Binding HasData}">
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Топ-10 страв" Classes="h2" />
                        <Grid ColumnDefinitions="36,*,90,110" Margin="0,4,0,0">
                            <TextBlock Text="#" Classes="caption" />
                            <TextBlock Grid.Column="1" Text="СТРАВА" Classes="caption" />
                            <TextBlock Grid.Column="2" Text="ПРОДАНО" Classes="caption" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="ВИРУЧКА" Classes="caption" HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TopDishes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DishReportRow">
                                    <Grid ColumnDefinitions="36,*,90,110" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.RowSpan="2" Text="{Binding Rank}" Classes="mono dim" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1">
                                            <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Category}" Foreground="{StaticResource TextDimBrush}" FontSize="11.5" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Quantity}" HorizontalAlignment="Right" Classes="muted" />
                                        <TextBlock Grid.Column="3" Text="{Binding Revenue}" HorizontalAlignment="Right" FontWeight="Bold" />
                                        <c:LevelMeter Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Value="{Binding Ratio}"
                                                      Fill="{StaticResource FlameBrush}" Height="4" Margin="0,6,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Результати офіціантів" Classes="h2" />
                        <ItemsControl ItemsSource="{Binding Waiters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WaiterReportRow">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                                        <Border Grid.RowSpan="3" Width="44" Height="44" CornerRadius="14"
                                                Background="{StaticResource BlueSoftBrush}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Initials}" FontWeight="ExtraBold" Foreground="{StaticResource BlueBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Revenue}" FontWeight="ExtraBold" Classes="accent" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,2,0,0" Classes="dim small">
                                            <Run Text="{Binding Orders}" />
                                            <Run Text="· середній чек" />
                                            <Run Text="{Binding AverageCheck}" />
                                        </TextBlock>
                                        <c:LevelMeter Grid.Row="2" Grid.Column="1" Margin="12,8,0,0" Value="{Binding Ratio}"
                                                      Fill="{StaticResource BlueBrush}" Height="5" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
