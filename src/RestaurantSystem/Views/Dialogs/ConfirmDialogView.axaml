<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="using:RestaurantSystem.ViewModels.Dialogs"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="RestaurantSystem.Views.Dialogs.ConfirmDialogView"
             x:DataType="d:ConfirmDialogViewModel">
    <Border Classes="card" Width="440" Padding="28" BoxShadow="0 30 80 0 #99000000">
        <StackPanel Spacing="14">
            <Panel HorizontalAlignment="Left">
                <Border Classes="iconBubble" IsVisible="{Binding IsNormal}">
                    <mi:MaterialIcon Kind="HelpCircleOutline" Width="22" Height="22" Foreground="{StaticResource AccentBrush}" />
                </Border>
                <Border Classes="iconBubble" Background="{StaticResource RedSoftBrush}" IsVisible="{Binding IsDanger}">
                    <mi:MaterialIcon Kind="AlertOutline" Width="22" Height="22" Foreground="{StaticResource RedBrush}" />
                </Border>
            </Panel>
            <TextBlock Text="{Binding Title}" Classes="h1" FontSize="22" />
            <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" LineHeight="21" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                <Button Classes="ghost" Content="Відмінити" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Classes="primary" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
                        IsVisible="{Binding IsNormal}" IsDefault="True" />
                <Button Classes="danger" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
                        IsVisible="{Binding IsDanger}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
